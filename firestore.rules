rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Listings: public reads on available cards, writes restricted to the owning seller
    match /listings/{listingId} {
      // Anyone (logged in or not) can read available listings
      allow read: if resource.data.status == 'available';

      // Only the authenticated seller who owns the listing can create/update/delete
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.sellerId;

      allow update, delete: if request.auth != null
                             && request.auth.uid == resource.data.sellerId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
